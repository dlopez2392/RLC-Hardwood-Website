---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/ui/PageHero.astro';
import Illo from '@/components/brand/Illo.astro';
import CtaBand from '@/components/sections/CtaBand.astro';
import { PROGRAMS } from '@/data/programs';
import { dict, fmtMoney, href, type Lang } from '@/i18n';
import { breadcrumb } from '@/lib/schema';
interface Props { lang: Lang }
const { lang } = Astro.props;
const c = dict(
  {
    title: 'Programs', desc: 'Infant, toddler, preschool, Pre-K and after-school programs in San Antonio with published ratios, sample tuition and hour-by-hour daily schedules. (Fictional demo.)',
    eyebrow: 'Programs · 6 weeks to 10 years', h1: 'One building, five rooms, <em class="italic-sun">one philosophy</em>.',
    lede: 'Every room shares the same belief: children learn best when they feel safe, known and free to follow a question. What changes is how we set the room, and how much we step back.',
    jump: 'Jump to a program', ratio: 'Teacher ratio', texas: 'Texas minimum', group: 'Max group size', tuition: 'Full-time tuition', mo: '/month', focus: 'Curriculum focus',
    day: 'A sample day', highlights: 'What is included in this room', tour: 'Book a tour of', estimate: 'Estimate my tuition', sample: 'Sample rate',
  },
  {
    title: 'Programas', desc: 'Programas para bebés, niños pequeños, preescolar, prekínder y después de clases en San Antonio, con proporciones publicadas, colegiatura de muestra y horarios hora por hora. (Demo ficticio).',
    eyebrow: 'Programas · de 6 semanas a 10 años', h1: 'Un edificio, cinco salones, <em class="italic-sun">una filosofía</em>.',
    lede: 'Todos los salones comparten una idea: los niños aprenden mejor cuando se sienten seguros, conocidos y libres de seguir una pregunta. Lo que cambia es cómo preparamos el salón y cuánto nos hacemos a un lado.',
    jump: 'Ir a un programa', ratio: 'Proporción', texas: 'Mínimo en Texas', group: 'Grupo máximo', tuition: 'Colegiatura de tiempo completo', mo: '/mes', focus: 'Enfoque del plan de estudios',
    day: 'Un día de ejemplo', highlights: 'Lo que incluye este salón', tour: 'Agende una visita al salón', estimate: 'Calcular mi colegiatura', sample: 'Tarifa de muestra',
  },
)[lang];
---
<BaseLayout lang={lang} route="programs" title={c.title} description={c.desc} schema={[breadcrumb(Astro.site!, lang, 'programs', c.title)]}>
  <PageHero eyebrow={c.eyebrow} title={c.h1} lede={c.lede} illo="blocks" />

  <nav aria-label={c.jump} class="sticky top-[4.5rem] z-30 border-b border-[rgb(31_58_51/.08)] bg-[rgb(251_246_238/.92)] backdrop-blur no-print">
    <ul class="scroll-x container-x flex gap-2 overflow-x-auto py-3">
      {PROGRAMS.map((p) => (
        <li class="shrink-0">
          <a href={`#${p.id}`} class="inline-flex min-h-11 items-center gap-2 rounded-full px-4 text-[0.9375rem] font-semibold transition hover:bg-[var(--color-paper)]">
            <span class="size-3 rounded-full" style={`background:${p.tone.bg}; box-shadow: inset 0 0 0 1.5px rgb(31 58 51 / .35)`} aria-hidden="true"></span>
            {p.room} <span class="font-normal text-[var(--color-ink-soft)]">· {p.name[lang]}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>

  {PROGRAMS.map((p, i) => (
    <section id={p.id} class="cv-auto section-y scroll-mt-32" aria-labelledby={`${p.id}-title`} style={i % 2 ? 'background: var(--color-paper)' : ''}>
      <div class="container-x grid gap-12 lg:grid-cols-[1.05fr_0.95fr] lg:gap-16">
        <div data-reveal>
          <div class="flex items-center gap-5">
            <div class="grid size-24 shrink-0 place-items-center rounded-[1.5rem]" style={`background:${p.tone.bg}`}><Illo name={p.illo} class="size-20" /></div>
            <div>
              <p class="eyebrow">{p.ages[lang]}</p>
              <h2 id={`${p.id}-title`} class="display-md mt-1">{p.room} <span class="font-sans text-[1.25rem] font-semibold tracking-normal">· {p.name[lang]}</span></h2>
            {lang === 'es' && <p class="mt-1 text-[0.9375rem] italic text-[var(--color-ink-soft)]">{p.room} = {p.bird}</p>}
            </div>
          </div>

          <dl class="mt-9 grid grid-cols-2 gap-px overflow-hidden rounded-[var(--radius-paper)] bg-[rgb(31_58_51/.12)] sm:grid-cols-4">
            <div class="bg-[#fffdf9] p-4"><dt class="text-[0.75rem] font-bold uppercase tracking-[0.1em] text-[var(--color-ink-soft)]">{c.ratio}</dt><dd class="mt-1 font-display text-[1.75rem] leading-none" style="font-weight:450">1 : {p.ratio}</dd></div>
            <div class="bg-[#fffdf9] p-4"><dt class="text-[0.75rem] font-bold uppercase tracking-[0.1em] text-[var(--color-ink-soft)]">{c.texas}</dt><dd class="mt-1 font-display text-[1.75rem] leading-none text-[var(--color-ink-soft)]" style="font-weight:450">1 : {p.texasMin}</dd></div>
            <div class="bg-[#fffdf9] p-4"><dt class="text-[0.75rem] font-bold uppercase tracking-[0.1em] text-[var(--color-ink-soft)]">{c.group}</dt><dd class="mt-1 font-display text-[1.75rem] leading-none" style="font-weight:450">{p.groupMax}</dd></div>
            <div class="bg-[#fffdf9] p-4"><dt class="text-[0.75rem] font-bold uppercase tracking-[0.1em] text-[var(--color-ink-soft)]">{c.tuition}</dt><dd class="mt-1 font-display text-[1.75rem] leading-none" style="font-weight:450">{fmtMoney(p.monthly, lang)}<span class="font-sans text-sm">{c.mo}</span></dd><dd class="mt-1.5"><span class="sample-badge">{c.sample}</span></dd></div>
          </dl>

          <h3 class="mt-10 text-[1.75rem]">{p.focusTitle[lang]}</h3>
          <p class="mt-3 text-[1.0625rem] leading-relaxed text-[var(--color-ink-soft)]">{p.focus[lang]}</p>

          <h3 class="mt-8 font-sans text-[0.8125rem] font-bold uppercase tracking-[0.12em]">{c.highlights}</h3>
          <ul class="mt-3 grid gap-2 sm:grid-cols-2">
            {p.highlights[lang].map((h) => (
              <li class="flex gap-2.5"><svg class="mt-1 shrink-0" width="16" height="16" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" fill="none" stroke="#6F8A64" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" /></svg>{h}</li>
            ))}
          </ul>
          <div class="mt-9 flex flex-wrap gap-3">
            <a href={`${href('tour', lang)}?program=${p.id}`} class="btn btn-primary">{c.tour} {p.room}</a>
            <a href={`${href('tuition', lang)}?program=${p.id}`} class="btn btn-ghost">{c.estimate}</a>
          </div>
        </div>

        <div class="paper p-6 sm:p-8 lg:self-start" data-reveal data-reveal-delay="120">
          <h3 class="flex items-center justify-between gap-3 text-[1.5rem]">{c.day}<span class="chip" style={`background:${p.tone.bg}`}>{p.room}</span></h3>
          <ol class="relative mt-6 space-y-0">
            <span class="absolute top-2 bottom-2 left-[3.35rem] w-[2px] bg-[repeating-linear-gradient(180deg,var(--color-sun)_0_6px,transparent_6px_12px)] opacity-60" aria-hidden="true"></span>
            {p.schedule.map((s) => (
              <li class="relative grid grid-cols-[3.2rem_1fr] items-baseline gap-5 py-2.5">
                <span class="text-right text-[0.9375rem] font-bold tabular-nums">{s.time}</span>
                <span class="relative pl-1"><span class="absolute top-[0.45rem] -left-[0.95rem] size-2.5 rounded-full border-2 border-[#fffdf9]" style={`background:${p.tone.accent}`} aria-hidden="true"></span>{s.label[lang]}</span>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>
  ))}
  <div class="pt-[var(--section-y)]"><CtaBand lang={lang} /></div>
</BaseLayout>
