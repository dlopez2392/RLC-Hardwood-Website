---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/ui/PageHero.astro';
import ContactForm from '@/components/islands/ContactForm';
import { SITE } from '@/data/site';
import { dict, href, type Lang } from '@/i18n';
import { breadcrumb } from '@/lib/schema';
interface Props { lang: Lang }
const { lang } = Astro.props;
const c = dict(
  {
    title: 'Contact', desc: 'Visit, call or write to Sunroom Early Learning Studio in San Antonio, TX. Hours, address and a quick contact form. (Fictional demo.)',
    eyebrow: 'Contact', h1: 'Come say <em class="italic-sun">hello</em>.',
    lede: 'We answer every message within one business day, usually much sooner, in English or Spanish.',
    visit: 'Visit', call: 'Call or text', write: 'Email', hours: 'Hours',
    week: [['Monday–Friday', '7:00 a.m. – 6:00 p.m.'], ['Saturday & Sunday', 'Closed'], ['Tours', 'Tue–Thu · 9:30 a.m., 10:30 a.m. & 4:00 p.m.']],
    directions: 'Two blocks from Olmos Park. Covered drop-off lane and free parking on Arbor Light Lane.',
    map: 'Illustrated map: Sunroom is on Arbor Light Lane near Olmos Park, north of downtown San Antonio.',
    mapNote: 'Map placeholder: an interactive map would load here in production (kept out of the demo for speed and privacy).',
    tour: 'Rather see it in person?', tourCta: 'Book a tour',
  },
  {
    title: 'Contacto', desc: 'Visite, llame o escriba a Sunroom Early Learning Studio en San Antonio, TX. Horario, dirección y un formulario de contacto rápido. (Demo ficticio).',
    eyebrow: 'Contacto', h1: 'Venga a <em class="italic-sun">saludarnos</em>.',
    lede: 'Respondemos cada mensaje en menos de un día hábil, casi siempre mucho antes, en inglés o en español.',
    visit: 'Visítenos', call: 'Llame o mande mensaje', write: 'Correo', hours: 'Horario',
    week: [['Lunes a viernes', '7:00 a. m. – 6:00 p. m.'], ['Sábado y domingo', 'Cerrado'], ['Visitas', 'Martes a jueves · 9:30 a. m., 10:30 a. m. y 4:00 p. m.']],
    directions: 'A dos cuadras de Olmos Park. Carril techado para dejar a los niños y estacionamiento gratuito en Arbor Light Lane.',
    map: 'Mapa ilustrado: Sunroom está en Arbor Light Lane, cerca de Olmos Park, al norte del centro de San Antonio.',
    mapNote: 'Mapa de muestra: en producción aquí se cargaría un mapa interactivo (lo dejamos fuera del demo por velocidad y privacidad).',
    tour: '¿Prefiere conocerlo en persona?', tourCta: 'Agende una visita',
  },
)[lang];
---
<BaseLayout lang={lang} route="contact" title={c.title} description={c.desc} schema={[breadcrumb(Astro.site!, lang, 'contact', c.title)]}>
  <PageHero eyebrow={c.eyebrow} title={c.h1} lede={c.lede} illo="door" tone="var(--color-blush)" />
  <section class="container-x section-y !pt-12 grid gap-10 lg:grid-cols-[0.9fr_1.1fr]">
    <div class="space-y-8">
      <dl class="grid gap-6 sm:grid-cols-2">
        <div><dt class="eyebrow">{c.visit}</dt><dd class="mt-2"><address class="not-italic">{SITE.street}<br />{SITE.city}, {SITE.region} {SITE.postal}</address></dd></div>
        <div><dt class="eyebrow">{c.call}</dt><dd class="mt-2"><a href={SITE.phoneHref} class="link-draw text-[1.125rem]">{SITE.phone}</a></dd></div>
        <div class="sm:col-span-2"><dt class="eyebrow">{c.write}</dt><dd class="mt-2"><a href={`mailto:${SITE.email}`} class="link-draw break-all">{SITE.email}</a></dd></div>
      </dl>
      <div>
        <h2 class="eyebrow">{c.hours}</h2>
        <table class="mt-3 w-full text-left">
          <tbody>{c.week.map(([d, h]) => <tr class="border-b border-[rgb(31_58_51/.1)]"><th scope="row" class="py-2.5 font-semibold">{d}</th><td class="py-2.5 text-right">{h}</td></tr>)}</tbody>
        </table>
      </div>
      <figure class="overflow-hidden rounded-[var(--radius-paper)] bg-[var(--color-sage-soft)]">
        <svg viewBox="0 0 520 300" role="img" aria-label={c.map} class="block h-auto w-full">
          <rect width="520" height="300" fill="#E7EDDD" />
          <path d="M0 70h520M0 190h520M110 0v300M330 0v300M430 0v300" stroke="#FBF6EE" stroke-width="16" />
          <path d="M-10 260C90 210 200 280 300 230s170-50 230-90" stroke="#CFE0E3" stroke-width="22" fill="none" />
          <ellipse cx="400" cy="120" rx="64" ry="38" fill="#A9B99A" />
          <circle cx="380" cy="112" r="10" fill="#6F8A64" /><circle cx="410" cy="128" r="12" fill="#6F8A64" /><circle cx="430" cy="106" r="8" fill="#6F8A64" />
          <text x="400" y="176" text-anchor="middle" font-size="13" font-weight="700" fill="#1F3A33" font-family="system-ui">Olmos Park</text>
          <text x="210" y="62" text-anchor="middle" font-size="11" fill="#4A5C55" font-family="system-ui">Arbor Light Ln</text>
          <g transform="translate(220 128)">
            <circle r="30" fill="#E2683C" opacity=".2" class="anim-ping" />
            <path d="M0 20C-14 4-20-8-20-16a20 20 0 0 1 40 0c0 8-6 20-20 36Z" fill="#E2683C" />
            <circle cy="-16" r="7" fill="#FBF6EE" />
          </g>
          <rect x="176" y="168" width="88" height="26" rx="13" fill="#1F3A33" /><text x="220" y="186" text-anchor="middle" font-size="12" font-weight="700" fill="#FBF6EE" font-family="system-ui">Sunroom</text>
        </svg>
        <figcaption class="px-5 py-3 text-[0.875rem]">{c.directions} <span class="block text-[0.8125rem] text-[var(--color-ink-soft)]">{c.mapNote}</span></figcaption>
      </figure>
    </div>
    <div>
      <ContactForm client:visible lang={lang} />
      <p class="mt-6 text-center font-display text-[1.375rem]" style="font-style:italic">{c.tour} <a class="link-draw font-sans text-[1rem] not-italic" href={href('tour', lang)}>{c.tourCta} →</a></p>
    </div>
  </section>
</BaseLayout>
