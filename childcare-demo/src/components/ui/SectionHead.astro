---
interface Props { eyebrow?: string; title: string; lede?: string; align?: 'left' | 'center'; id?: string; size?: 'lg' | 'md'; class?: string }
const { eyebrow, title, lede, align = 'left', id, size = 'lg', class: cls = '' } = Astro.props;
---
<div class:list={['max-w-3xl', align === 'center' && 'mx-auto text-center', cls]} data-reveal>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <h2 id={id} class:list={[size === 'lg' ? 'display-lg' : 'display-md', eyebrow && 'mt-4']} set:html={title} />
  {lede && <p class:list={['lede mt-5', align === 'center' && 'mx-auto max-w-2xl']}>{lede}</p>}
  <slot />
</div>
