---
import Illo, { type IlloName } from '@/components/brand/Illo.astro';
interface Props { eyebrow: string; title: string; lede?: string; illo?: IlloName; tone?: string; id?: string }
const { eyebrow, title, lede, illo, tone = 'var(--color-paper)', id = 'page-title' } = Astro.props;
---
<section class="relative overflow-hidden" style={`background:${tone}`} aria-labelledby={id}>
  <div class="container-x grid items-end gap-8 pt-14 pb-14 md:grid-cols-[1fr_auto] md:pt-20 md:pb-20">
    <div class="max-w-3xl">
      <p class="eyebrow !text-[var(--color-sun-deep)]">{eyebrow}</p>
      <h1 id={id} class="display-lg mt-4" style="view-transition-name: page-title" set:html={title} />
      {lede && <p class="lede mt-6 max-w-2xl">{lede}</p>}
      <slot />
    </div>
    {illo && <div class="hidden size-48 md:block lg:size-60" aria-hidden="true"><Illo name={illo} class="h-full w-full" /></div>}
  </div>
  <svg class="block w-full text-[var(--color-cream)]" viewBox="0 0 1440 40" preserveAspectRatio="none" aria-hidden="true" height="28"><path d="M0 40V22c120-14 260-20 420-12s300 18 460 10 360-26 560-8v28Z" fill="currentColor" /></svg>
</section>
