---
import Illo, { type IlloName } from '@/components/brand/Illo.astro';
import { Picture } from 'astro:assets';
import { PHOTOS, type PhotoKey } from '@/data/photos';
import type { Lang } from '@/i18n';
interface Props { eyebrow: string; title: string; lede?: string; illo?: IlloName; photo?: PhotoKey; lang?: Lang; tone?: string; id?: string }
const { eyebrow, title, lede, illo, photo, lang = 'en', tone = 'var(--color-paper)', id = 'page-title' } = Astro.props;
---
<section class="relative overflow-hidden" style={`background:${tone}`} aria-labelledby={id}>
  <div class="container-x grid items-end gap-8 pt-14 pb-14 md:grid-cols-[1fr_auto] md:pt-20 md:pb-20">
    <div class="max-w-3xl">
      <p class="eyebrow !text-[var(--color-sun-deep)]">{eyebrow}</p>
      <h1 id={id} class="display-lg mt-4" style="view-transition-name: page-title" set:html={title} />
      {lede && <p class="lede mt-6 max-w-2xl">{lede}</p>}
      <slot />
    </div>
    {photo && (
      <div class="relative aspect-[4/5] w-40 justify-self-end overflow-hidden rounded-t-full shadow-[var(--shadow-lift)] sm:w-48 md:w-60 lg:w-72">
        <Picture src={PHOTOS[photo].src} alt={PHOTOS[photo].alt[lang]} formats={['avif', 'webp']} widths={[320, 480, 640]} sizes="(min-width: 1024px) 18rem, (min-width: 768px) 15rem, 12rem" loading="eager" decoding="async" class="h-full w-full object-cover" />
        <div class="pointer-events-none absolute inset-0 rounded-t-full ring-[5px] ring-inset ring-[var(--color-ink)]" aria-hidden="true"></div>
        <div class="pointer-events-none absolute top-[12%] right-[14%] size-10 rounded-full bg-[var(--color-sun)] shadow-[0_3px_0_rgb(31_58_51/.18)]" aria-hidden="true"></div>
      </div>
    )}
    {!photo && illo && (
      <div class="relative hidden aspect-[4/5] w-56 overflow-hidden rounded-t-full border-[5px] border-[var(--color-ink)] bg-[var(--color-cream)] shadow-[var(--shadow-lift)] md:block lg:w-72" aria-hidden="true">
        <div class="absolute inset-x-0 bottom-0 h-[38%] bg-[var(--color-sage)]"></div>
        <div class="absolute inset-x-0 bottom-0 h-[22%] bg-[var(--color-moss)]"></div>
        <div class="absolute top-[14%] right-[16%] size-12 rounded-full bg-[var(--color-sun)] opacity-90"></div>
        <div class="absolute inset-x-[12%] bottom-[10%] aspect-square"><Illo name={illo} class="h-full w-full" /></div>
      </div>
    )}
  </div>
  <svg class="block w-full text-[var(--color-cream)]" viewBox="0 0 1440 40" preserveAspectRatio="none" aria-hidden="true" height="28"><path d="M0 40V22c120-14 260-20 420-12s300 18 460 10 360-26 560-8v28Z" fill="currentColor" /></svg>
</section>
