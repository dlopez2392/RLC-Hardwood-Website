---
import { Picture } from 'astro:assets';
import { PHOTOS } from '@/data/photos';
import { STORIES } from '@/data/site';
import SectionHead from '@/components/ui/SectionHead.astro';
import { dict, ui, type Lang } from '@/i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const c = dict(
  { eyebrow: 'Family stories', title: 'Long stories, not <em class="italic-sun">one-line</em> reviews.', note: 'These families are fictional. Their stories show the kind of detail real reviews should carry.' },
  { eyebrow: 'Historias de familias', title: 'Historias largas, no reseñas de <em class="italic-sun">una línea</em>.', note: 'Estas familias son ficticias. Sus historias muestran el nivel de detalle que deberían tener las reseñas reales.' },
)[lang];
---
<section class="cv-auto section-y" aria-labelledby="stories-title">
  <div class="container-x">
    <SectionHead eyebrow={c.eyebrow} title={c.title} id="stories-title">
      <p class="mt-5 flex flex-wrap items-center gap-2 text-sm text-[var(--color-ink-soft)]"><span class="sample-badge">{t.sample}</span>{c.note}</p>
    </SectionHead>
    <ul class="mt-12 grid gap-6 lg:grid-cols-[1.2fr_1fr]">
      {STORIES.map((s, i) => (
        <li class:list={[i === 0 && 'lg:row-span-2']} data-reveal data-reveal-delay={i * 100}>
          {i === 0 ? (
            <figure class="on-dark grain relative flex h-full flex-col overflow-hidden rounded-[2rem] bg-[var(--color-dusk)] text-[var(--color-cream)]">
              <Picture src={PHOTOS.arrival.src} alt={PHOTOS.arrival.alt[lang]} formats={['avif', 'webp']} widths={[480, 720, 960]} sizes="(min-width: 1024px) 42rem, 92vw" loading="lazy" decoding="async" class="aspect-[16/9] h-auto w-full object-cover" />
              <div class="relative z-[2] flex flex-1 flex-col p-7 sm:p-10">
                <svg width="44" height="34" viewBox="0 0 44 34" aria-hidden="true" class="text-[var(--color-apricot)]"><path d="M0 34V20C0 8 7 1 18 0v7c-6 1-9 5-9 11h9v16Zm26 0V20C26 8 33 1 44 0v7c-6 1-9 5-9 11h9v16Z" fill="currentColor" /></svg>
                <blockquote class="mt-5 flex-1">
                  <p class="font-display text-[clamp(1.75rem,2.6vw,2.375rem)] leading-[1.15]" style="font-weight:440">{s.pull[lang]}</p>
                  <p class="mt-5 text-[1.0625rem] leading-relaxed text-[#e9e3d6]">{s.quote[lang]}</p>
                </blockquote>
                <figcaption class="mt-7 border-t border-[rgb(251_246_238/.2)] pt-4">
                  <p class="font-bold">{s.family[lang]}</p>
                  <p class="text-[0.875rem] text-[#e9e3d6]">{s.child[lang]} · {s.since[lang]}</p>
                </figcaption>
              </div>
            </figure>
          ) : (
            <figure class="relative flex h-full flex-col rounded-[2rem] p-7 sm:p-8" style={`background:${s.tone}`}>
              <blockquote class="flex-1">
                <p class="font-display text-[1.5rem] leading-snug" style="font-weight:450">{s.pull[lang]}</p>
                <p class="mt-3 text-[0.9875rem] leading-relaxed">{s.quote[lang]}</p>
              </blockquote>
              <figcaption class="mt-5 border-t border-[rgb(31_58_51/.15)] pt-4">
                <p class="font-bold">{s.family[lang]}</p>
                <p class="text-[0.875rem]">{s.child[lang]} · {s.since[lang]}</p>
              </figcaption>
            </figure>
          )}
        </li>
      ))}
    </ul>
  </div>
</section>
