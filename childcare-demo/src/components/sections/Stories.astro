---
import { STORIES } from '@/data/site';
import SectionHead from '@/components/ui/SectionHead.astro';
import { dict, ui, type Lang } from '@/i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const c = dict(
  { eyebrow: 'Family stories', title: 'Long stories, not <em class="italic-sun">one-line</em> reviews.', note: 'These families are fictional. Their stories show the kind of detail real reviews should carry.' },
  { eyebrow: 'Historias de familias', title: 'Historias largas, no reseñas de <em class="italic-sun">una línea</em>.', note: 'Estas familias son ficticias. Sus historias muestran el nivel de detalle que deberían tener las reseñas reales.' },
)[lang];
---
<section class="cv-auto section-y" aria-labelledby="stories-title">
  <div class="container-x">
    <SectionHead eyebrow={c.eyebrow} title={c.title} id="stories-title">
      <p class="mt-5 flex flex-wrap items-center gap-2 text-sm text-[var(--color-ink-soft)]"><span class="sample-badge">{t.sample}</span>{c.note}</p>
    </SectionHead>
    <ul class="mt-14 grid gap-6 lg:grid-cols-3">
      {STORIES.map((s, i) => (
        <li data-reveal data-reveal-delay={i * 100}>
          <figure class="relative flex h-full flex-col rounded-[var(--radius-paper)] p-7 sm:p-8" style={`background:${s.tone}`}>
            <svg width="44" height="34" viewBox="0 0 44 34" aria-hidden="true" class="text-[var(--color-sun)]"><path d="M0 34V20C0 8 7 1 18 0v7c-6 1-9 5-9 11h9v16Zm26 0V20C26 8 33 1 44 0v7c-6 1-9 5-9 11h9v16Z" fill="currentColor" /></svg>
            <blockquote class="mt-5 flex-1">
              <p class="font-display text-[1.5rem] leading-snug" style="font-weight:450">{s.pull[lang]}</p>
              <p class="mt-4 text-[0.9875rem] leading-relaxed">{s.quote[lang]}</p>
            </blockquote>
            <figcaption class="mt-6 border-t border-[rgb(31_58_51/.15)] pt-4">
              <p class="font-bold">{s.family[lang]}</p>
              <p class="text-[0.875rem]">{s.child[lang]} · {s.since[lang]}</p>
            </figcaption>
          </figure>
        </li>
      ))}
    </ul>
  </div>
</section>
