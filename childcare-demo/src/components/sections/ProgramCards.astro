---
import { Picture } from 'astro:assets';
import { PHOTOS, PROGRAM_PHOTO } from '@/data/photos';
import SectionHead from '@/components/ui/SectionHead.astro';
import { PROGRAMS } from '@/data/programs';
import { dict, fmtMoney, href, ui, type Lang } from '@/i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const t = ui[lang];
const c = dict(
  {
    eyebrow: 'Programs, 6 weeks to 10 years',
    title: 'Five rooms, each named for a <em class="italic-sun">bird</em> that grows up here.',
    lede: 'We publish our ratios and tuition right here, on the first page, because you should not need a sales call to learn them.',
    ratio: 'ratio',
    from: 'from',
    mo: '/mo',
    explore: 'Explore',
  },
  {
    eyebrow: 'Programas, de 6 semanas a 10 años',
    title: 'Cinco salones, cada uno con el nombre de un <em class="italic-sun">pájaro</em> que crece aquí.',
    lede: 'Publicamos la proporción de maestros y la colegiatura aquí, en la primera página, porque no debería necesitar una llamada de ventas para saberlas.',
    ratio: 'proporción',
    from: 'desde',
    mo: '/mes',
    explore: 'Conozca',
  },
)[lang];
---
<section class="cv-auto section-y bg-[var(--color-paper)]" aria-labelledby="programs-title">
  <div class="container-x">
    <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
      <SectionHead eyebrow={c.eyebrow} title={c.title} lede={c.lede} id="programs-title" />
      <a href={href('programs', lang)} class="btn btn-ghost shrink-0" data-reveal>{t.cta.programs}</a>
    </div>
    <ul class="scroll-x -mx-[var(--gutter)] mt-12 grid snap-x snap-mandatory auto-cols-[76%] grid-flow-col gap-4 overflow-x-auto px-[var(--gutter)] pb-3 sm:mx-0 sm:auto-cols-auto sm:grid-flow-row sm:grid-cols-2 sm:overflow-visible sm:px-0 lg:grid-cols-3 xl:grid-cols-5">
      {PROGRAMS.map((p, i) => (
        <li class="lift group relative flex snap-start flex-col overflow-hidden rounded-[var(--radius-paper)] shadow-[var(--shadow-paper)]" style={`background:${p.tone.bg}`} data-reveal data-reveal-delay={i * 80}>
          <div class="relative aspect-[4/3] overflow-hidden">
            <Picture src={PHOTOS[PROGRAM_PHOTO[p.id]].src} alt={PHOTOS[PROGRAM_PHOTO[p.id]].alt[lang]} formats={['avif', 'webp']} widths={[320, 480, 640]} sizes="(min-width: 1280px) 16rem, (min-width: 640px) 45vw, 76vw" loading="lazy" decoding="async" class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105" />
            <p class="absolute top-3 left-3 rounded-full px-3 py-1 text-[0.75rem] font-bold uppercase tracking-[0.1em]" style={`background:${p.tone.bg}`}>{p.ages[lang]}</p>
          </div>
          <div class="px-5 pt-4 pb-3">
            <h3 class="text-[1.875rem] leading-none">{p.room}{lang === 'es' && <span class="ml-2 font-sans text-[0.8125rem] font-semibold italic tracking-normal">({p.bird})</span>}</h3>
            <p class="mt-1.5 font-semibold">{p.name[lang]}</p>
          </div>
          <div class="mt-auto flex items-end justify-between gap-3 border-t border-[rgb(31_58_51/.12)] bg-[rgb(255_253_249/.55)] px-5 py-3.5">
            <div>
              <p class="text-[0.75rem] font-bold uppercase tracking-[0.1em]">{c.ratio}</p>
              <p class="font-display text-[1.375rem] leading-tight" style="font-weight:450">1 : {p.ratio}</p>
            </div>
            <div class="text-right">
              <p class="text-[0.75rem] font-bold uppercase tracking-[0.1em]">{c.from} <span class="sr-only">({t.sample})</span></p>
              <p class="font-display text-[1.375rem] leading-tight" style="font-weight:450">{fmtMoney(Math.round(p.monthly * 0.48), lang)}<span class="text-sm font-sans">{c.mo}</span></p>
            </div>
          </div>
          <a href={href('programs', lang, p.id)} class="absolute inset-0 rounded-[inherit]"><span class="sr-only">{c.explore} {p.room} · {p.name[lang]}</span></a>
        </li>
      ))}
    </ul>
    <p class="mt-6 flex items-center gap-2 text-sm text-[var(--color-ink-soft)]"><span class="sample-badge">{t.sampleShort}</span>{lang === 'en' ? '“From” is the 2-day part-time rate. Full-time rates are on each program.' : '“Desde” es la tarifa de medio tiempo de 2 días. Las tarifas de tiempo completo están en cada programa.'}</p>
  </div>
</section>
