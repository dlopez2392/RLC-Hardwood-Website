---
import Illo from '@/components/brand/Illo.astro';
import { DAY } from '@/data/calendar';
import { dict, href, type Lang } from '@/i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const arc = (h: number) => Math.round(Math.sin(Math.PI * Math.min(1, Math.max(0, (h - 6) / 12))) * 30);
const dot = (h: number) => (h < 8 ? '#F6C49A' : h < 15 ? '#E2683C' : h < 16.5 ? '#C8552B' : '#A8431D');
const c = dict(
  { eyebrow: 'A day at Sunroom', title: 'From the first hello to golden hour.', cta: 'Scroll through a whole day', list: 'The shape of a Sunroom day' },
  { eyebrow: 'Un día en Sunroom', title: 'Del primer saludo a la hora dorada.', cta: 'Recorra un día completo', list: 'La forma de un día en Sunroom' },
)[lang];
---
<section class="section-y overflow-hidden" aria-labelledby="ribbon-title">
  <div class="container-x">
    <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between" data-reveal>
      <div>
        <p class="eyebrow">{c.eyebrow}</p>
        <h2 id="ribbon-title" class="display-lg mt-4 max-w-2xl">{c.title}</h2>
      </div>
      <a href={href('day', lang)} class="btn btn-primary shrink-0">{c.cta} <span aria-hidden="true">→</span></a>
    </div>
  </div>
  <div class="relative mt-14">
    <div class="pointer-events-none absolute inset-x-0 top-[6.4rem] h-[3px] bg-[repeating-linear-gradient(90deg,var(--color-sun)_0_10px,transparent_10px_18px)] opacity-60" aria-hidden="true"></div>
    <ol class="scroll-x container-x flex snap-x gap-4 overflow-x-auto pb-6" aria-label={c.list} tabindex="0">
      {DAY.map((d, i) => (
        <li class="w-[13.5rem] shrink-0 snap-start" data-reveal data-reveal-delay={i * 60}>
          <a href={href('day', lang, d.id)} class="group block rounded-[var(--radius-paper)] p-2 focus-visible:outline-offset-0">
            <span class="mx-auto block w-fit rounded-full bg-[var(--color-ink)] px-3 py-1 text-sm font-bold tabular-nums text-[var(--color-cream)]">{d.time}</span>
            <span class="relative z-[1] mx-auto mt-5 block size-14 rounded-full border-[3px] border-[var(--color-cream)] shadow-[var(--shadow-paper)] transition-transform duration-500 group-hover:scale-110" style={`background:${dot(d.hour)}; transform: translateY(${30 - arc(d.hour)}px)`} aria-hidden="true"></span>
            <span class="mt-10 block aspect-square rounded-[var(--radius-paper)] bg-[var(--color-paper)] p-5 transition duration-500 group-hover:-translate-y-1 group-hover:bg-[var(--color-sage-soft)]">
              <Illo name={d.scene} class="h-full w-full" />
            </span>
            <span class="mt-3 block text-center font-display text-[1.375rem] leading-tight" style="font-weight:450">{d.title[lang]}</span>
          </a>
        </li>
      ))}
    </ol>
  </div>
</section>
