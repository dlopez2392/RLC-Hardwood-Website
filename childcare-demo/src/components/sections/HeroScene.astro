---
/**
 * The arched-window scene. Sky colours and sun position are driven by CSS custom
 * properties (--sky-top, --sky-bottom, --sun-x, --sun-y, --night) that the hero
 * script sets from the current time in San Antonio. Server-rendered at mid-morning.
 */
interface Props { label: string }
const { label } = Astro.props;
---
<svg viewBox="0 0 600 680" class="hero-scene block h-full w-full" role="img" aria-label={label}>
  <defs>
    <clipPath id="arch"><path d="M0 680V300C0 134 134 0 300 0s300 134 300 300v380Z" /></clipPath>
    <linearGradient id="sky" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" style="stop-color: var(--sky-top, #CFE0E3)" />
      <stop offset="0.75" style="stop-color: var(--sky-bottom, #FBF6EE)" />
    </linearGradient>
    <radialGradient id="glow">
      <stop offset="0" stop-color="#F7DFA6" stop-opacity=".9" />
      <stop offset="1" stop-color="#F7DFA6" stop-opacity="0" />
    </radialGradient>
  </defs>
  <g clip-path="url(#arch)">
    <rect width="600" height="680" fill="url(#sky)" />
    <!-- stars (visible at night) -->
    <g class="hero-stars" fill="#FBF6EE" style="opacity: var(--night, 0)">
      <circle cx="90" cy="150" r="2.4" /><circle cx="180" cy="90" r="1.6" /><circle cx="420" cy="120" r="2" />
      <circle cx="510" cy="210" r="1.6" /><circle cx="300" cy="70" r="1.8" /><circle cx="350" cy="190" r="1.4" /><circle cx="140" cy="250" r="1.4" />
    </g>
    <!-- the sun travels on an arc; translate is set by script -->
    <g class="hero-sun" style="transform: translate(var(--sun-x, 380px), var(--sun-y, 210px))">
      <circle r="120" fill="url(#glow)" />
      <g class="anim-rays" style="opacity: calc(1 - var(--night, 0))">
        {Array.from({ length: 12 }).map((_, i) => (
          <rect x="-4" y="-92" width="8" height="22" rx="4" fill="#E2683C" opacity=".75" transform={`rotate(${i * 30})`} />
        ))}
      </g>
      <circle r="58" fill="#E2683C" style="opacity: calc(1 - var(--night, 0))" />
      <!-- moon replaces the sun at night -->
      <path d="M22 -50a52 52 0 1 0 28 92 44 44 0 0 1-28-92Z" fill="#F7DFA6" style="opacity: var(--night, 0)" />
    </g>
    <g class="anim-drift" fill="#FBF6EE" opacity=".92" style="filter: drop-shadow(0 3px 0 rgb(31 58 51 / .08))">
      <path d="M70 250c0-18 14-30 30-30 8-16 34-20 48-4 18-4 34 8 34 26v8H70Z" />
      <path d="M390 330c0-14 10-24 24-24 6-12 26-16 38-4 14-2 26 6 26 20v8h-88Z" opacity=".8" />
    </g>
    <!-- hills, cut paper -->
    <g style="filter: drop-shadow(0 -3px 0 rgb(31 58 51 / .1))">
      <path d="M-20 520c90-60 200-70 300-30s210 30 340-20v260H-20Z" fill="#A9B99A" />
      <path d="M-20 580c120-40 240-36 340-10s180 16 300-12v170H-20Z" fill="#6F8A64" />
    </g>
    <!-- the studio: a little building with arched, glowing windows -->
    <g style="filter: drop-shadow(0 4px 0 rgb(31 58 51 / .18))">
      <path d="M318 600V470l90-62 90 62v130Z" fill="#FBF6EE" />
      <path d="M306 474l102-72 102 72" stroke="#A8431D" stroke-width="14" fill="none" stroke-linecap="round" stroke-linejoin="round" />
      <path d="M346 600v-62a22 22 0 0 1 44 0v62Z" fill="#1F3A33" />
      <path d="M418 548v-30a20 20 0 0 1 40 0v30Z" class="hero-window" style="fill: var(--window, #CFE0E3)" />
      <path d="M380 470a14 14 0 0 1 28 0v18h-28Z" class="hero-window" style="fill: var(--window, #CFE0E3)" />
    </g>
    <!-- the old pecan -->
    <g>
      <rect x="128" y="470" width="20" height="150" rx="8" fill="#7A4E36" />
      <g class="anim-sway" style="transform-origin: 138px 620px">
        <path d="M138 336c62 0 100 40 100 88 0 32-26 50-56 44-14 22-72 24-90 4-32 8-64-14-60-46 6-50 46-90 106-90Z" fill="#1F3A33" />
        <circle cx="96" cy="402" r="34" fill="#2c4c43" /><circle cx="178" cy="392" r="38" fill="#2c4c43" />
        <circle cx="138" cy="368" r="34" fill="#355a4f" /><circle cx="122" cy="430" r="26" fill="#355a4f" />
        <circle cx="196" cy="436" r="22" fill="#6F8A64" opacity=".55" /><circle cx="84" cy="370" r="16" fill="#6F8A64" opacity=".5" />
        <g fill="#7A4E36"><ellipse cx="112" cy="452" rx="5" ry="7" /><ellipse cx="170" cy="446" rx="5" ry="7" /><ellipse cx="148" cy="404" rx="5" ry="7" /></g>
        <path d="M138 470c0-24 10-40 24-52M138 470c-6-20-18-32-32-38" stroke="#7A4E36" stroke-width="7" fill="none" stroke-linecap="round" />
      </g>
    </g>
    <!-- garden beds + tiny figures -->
    <rect x="40" y="628" width="120" height="22" rx="6" fill="#A8431D" />
    <g fill="#F7DFA6"><circle cx="64" cy="622" r="9" /><circle cx="98" cy="618" r="11" /><circle cx="132" cy="622" r="8" /></g>
    <g class="anim-bob">
      <circle cx="262" cy="590" r="11" fill="#F2CDBF" /><path d="M248 630c0-20 6-28 14-28s14 8 14 28Z" fill="#E2683C" />
    </g>
    <g class="anim-bob" style="animation-delay: -2s">
      <circle cx="292" cy="600" r="8" fill="#C98E6B" /><path d="M282 630c0-14 4-20 10-20s10 6 10 20Z" fill="#3B4A6B" />
    </g>
    <!-- kite on a string -->
    <g class="anim-sway" style="transform-origin: 292px 610px">
      <path d="M292 610C300 520 260 430 214 362" stroke="#1F3A33" stroke-width="1.6" fill="none" opacity=".6" />
      <path d="M214 330l22 30-22 34-22-34Z" fill="#3B4A6B" /><path d="M214 330l22 30h-22Z" fill="#E2683C" />
    </g>
  </g>
  <path d="M3 680V300C3 136 136 3 300 3s297 133 297 297v380" fill="none" stroke="#1F3A33" stroke-width="6" />
</svg>
