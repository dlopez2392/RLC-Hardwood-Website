---
import { Picture } from 'astro:assets';
import { PHOTOS } from '@/data/photos';
import { dict, href, type Lang } from '@/i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const c = dict(
  {
    label: 'Safety, in specifics',
    title: 'We would rather show you a list than make you <em class="text-[var(--color-apricot)]">a promise</em>.',
    badge: 'Licensed by Texas HHSC (sample)',
    items: [
      { k: '1 : 3', v: 'infant ratio (Texas allows 1 : 4)' },
      { k: '100%', v: 'of staff CPR & First Aid certified' },
      { k: 'RN', v: 'registered nurse on staff, daily' },
      { k: 'Fingerprint', v: 'entry plus photo-ID pick-up list' },
      { k: 'Nut-free', v: 'kitchen, cooking from scratch' },
    ],
    more: 'Everything we do for safety',
  },
  {
    label: 'Seguridad, con detalles',
    title: 'Preferimos mostrarle una lista que hacerle <em class="text-[var(--color-apricot)]">una promesa</em>.',
    badge: 'Con licencia de HHSC de Texas (muestra)',
    items: [
      { k: '1 : 3', v: 'proporción en bebés (Texas permite 1 : 4)' },
      { k: '100 %', v: 'del personal certificado en RCP y primeros auxilios' },
      { k: 'Enfermera', v: 'titulada en el personal, todos los días' },
      { k: 'Huella', v: 'digital para entrar y lista de recogida con foto' },
      { k: 'Sin nueces', v: 'cocina que prepara todo desde cero' },
    ],
    more: 'Todo lo que hacemos por la seguridad',
  },
)[lang];
---
<section class="cv-auto on-dark grain bg-[var(--color-ink)] text-[var(--color-cream)]" aria-labelledby="trust-title">
  <div class="container-x relative z-[2] grid items-center gap-10 py-16 lg:grid-cols-[0.95fr_1.05fr] lg:gap-16 lg:py-24">
    <div class="relative" data-reveal>
      <div class="overflow-hidden rounded-[2rem] rounded-tr-[9rem]">
        <Picture src={PHOTOS.gallery.src} alt={PHOTOS.gallery.alt[lang]} formats={['avif', 'webp']} widths={[480, 720, 960, 1200]} sizes="(min-width: 1024px) 38rem, 92vw" loading="lazy" decoding="async" class="aspect-[4/3] h-auto w-full object-cover" />
      </div>
      <div class="absolute -bottom-5 left-5 flex items-center gap-3 rounded-full bg-[var(--color-butter)] py-2.5 pr-5 pl-3 text-[var(--color-ink)] shadow-[var(--shadow-lift)]">
        <svg width="34" height="34" viewBox="0 0 120 120" aria-hidden="true"><circle cx="60" cy="60" r="56" fill="#1F3A33" /><path d="M60 26l9 19 21 3-15 15 4 21-19-10-19 10 4-21-15-15 21-3Z" fill="#F7DFA6" /></svg>
        <span class="text-[0.875rem] leading-tight font-bold">{c.badge}</span>
      </div>
    </div>
    <div>
      <p class="eyebrow">{c.label}</p>
      <h2 id="trust-title" class="display-md mt-4" set:html={c.title} />
      <ul class="mt-9 grid grid-cols-2 gap-x-8 gap-y-7">
        {c.items.map((it, i) => (
          <li class="border-t border-[rgb(251_246_238/.2)] pt-4" data-reveal data-reveal-delay={i * 70}>
            <p class="font-display text-[2rem] leading-none text-[var(--color-apricot)]" style="font-weight:450">{it.k}</p>
            <p class="mt-2 text-[0.9375rem] leading-snug text-[#e6ddcd]">{it.v}</p>
          </li>
        ))}
        <li class="flex items-end border-t border-[rgb(251_246_238/.2)] pt-4"><a href={href('safety', lang)} class="link-draw">{c.more} <span aria-hidden="true">→</span></a></li>
      </ul>
    </div>
  </div>
</section>
