---
import { dict, href, type Lang } from '@/i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const c = dict(
  {
    label: 'Safety, in specifics',
    items: [
      { k: '1 : 3', v: 'infant ratio (Texas allows 1 : 4)' },
      { k: '100%', v: 'of staff CPR & First Aid certified' },
      { k: 'RN', v: 'registered nurse on staff, daily' },
      { k: 'Fingerprint', v: 'entry plus photo-ID pick-up list' },
      { k: 'Nut-free', v: 'kitchen, cooking from scratch' },
    ],
    more: 'Read our safety & licensing details',
  },
  {
    label: 'Seguridad, con detalles',
    items: [
      { k: '1 : 3', v: 'proporción en bebés (Texas permite 1 : 4)' },
      { k: '100 %', v: 'del personal certificado en RCP y primeros auxilios' },
      { k: 'Enfermera', v: 'titulada en el personal, todos los días' },
      { k: 'Huella', v: 'digital para entrar y lista de recogida con foto' },
      { k: 'Sin nueces', v: 'cocina que prepara todo desde cero' },
    ],
    more: 'Lea los detalles de seguridad y licencia',
  },
)[lang];
---
<section class="cv-auto on-dark grain bg-[var(--color-ink)] text-[var(--color-cream)]" aria-labelledby="trust-title">
  <div class="container-x relative z-[2] py-14">
    <div class="flex flex-col gap-8 lg:flex-row lg:items-center lg:justify-between">
      <h2 id="trust-title" class="eyebrow shrink-0">{c.label}</h2>
      <ul class="grid grid-cols-2 gap-x-8 gap-y-6 sm:grid-cols-3 lg:grid-cols-5 lg:gap-x-10">
        {c.items.map((it, i) => (
          <li data-reveal data-reveal-delay={i * 70}>
            <p class="font-display text-[1.875rem] leading-none text-[var(--color-apricot)]" style="font-weight:450">{it.k}</p>
            <p class="mt-2 text-[0.9375rem] leading-snug text-[#e6ddcd]">{it.v}</p>
          </li>
        ))}
      </ul>
    </div>
    <a href={href('safety', lang)} class="link-draw mt-8 inline-block">{c.more} <span aria-hidden="true">→</span></a>
  </div>
</section>
