---
import Logo from '@/components/brand/Logo.astro';
import { ROUTES, href, otherLang, ui, type Lang, type RouteKey } from '@/i18n';
interface Props { lang: Lang; route: RouteKey | '404' }
const { lang, route } = Astro.props;
const t = ui[lang];
const other = otherLang(lang);
const switchHref = route === '404' ? ROUTES.home[other] : ROUTES[route][other];
const items: { key: RouteKey; label: string }[] = [
  { key: 'programs', label: t.nav.programs },
  { key: 'day', label: t.nav.day },
  { key: 'teachers', label: t.nav.teachers },
  { key: 'safety', label: t.nav.safety },
  { key: 'tuition', label: t.nav.tuition },
  { key: 'portal', label: t.nav.portal },
];
const mobileExtra: { key: RouteKey; label: string }[] = [
  { key: 'faq', label: t.nav.faq },
  { key: 'contact', label: t.nav.contact },
];
---
<header class="sticky top-0 z-40 border-b border-[rgb(31_58_51/0.08)] bg-[rgb(251_246_238/0.94)] backdrop-blur-md no-print" data-header>
  <div class="container-x flex h-[4.5rem] items-center justify-between gap-4">
    <a href={href('home', lang)} class="shrink-0 rounded-lg">
      <Logo size={38} /><span class="sr-only"> — {t.breadcrumbHome}</span>
    </a>

    <nav aria-label={t.nav.primary} class="hidden xl:block">
      <ul class="flex items-center gap-1">
        {items.map((it) => {
          const current = route === it.key;
          return (
            <li>
              <a
                href={href(it.key, lang)}
                aria-current={current ? 'page' : undefined}
                class:list={[
                  'relative rounded-full px-3.5 py-2 text-[0.9375rem] font-semibold transition-colors hover:bg-[var(--color-paper)]',
                  current && 'text-[var(--color-sun-ink)]',
                ]}
              >
                {it.label}
                {current && <span class="absolute inset-x-3.5 -bottom-0.5 h-[3px] rounded-full bg-[var(--color-sun)]" aria-hidden="true" />}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={switchHref}
        hreflang={other === 'es' ? 'es-US' : 'en-US'}
        lang={other}
        class="inline-flex min-h-11 items-center gap-1.5 rounded-full px-3 text-sm font-bold tracking-wide hover:bg-[var(--color-paper)]"
        title={t.lang.switchTo}
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3c3 3.2 3 14.8 0 18M12 3c-3 3.2-3 14.8 0 18" /></svg>
        <span class="hidden sm:inline">{t.lang.label}</span>
        <span class="sm:hidden">{t.lang.short}<span class="sr-only"> · {t.lang.label}</span></span>
      </a>
      <a href={href('tour', lang)} class="btn btn-primary hidden !min-h-11 !px-5 !text-[0.9375rem] sm:inline-flex">
        {t.nav.tour}
      </a>
      <button
        type="button"
        class="inline-flex size-11 items-center justify-center rounded-full hover:bg-[var(--color-paper)] xl:hidden"
        aria-expanded="false"
        aria-controls="mobile-nav"
        data-menu-open
      >
        <span class="sr-only">{t.nav.menu}</span>
        <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 8h16M4 16h11" /></svg>
      </button>
    </div>
  </div>

</header>

  <div id="mobile-nav" class="fixed inset-0 z-50 hidden bg-[var(--color-cream)] xl:hidden" data-menu-panel role="dialog" aria-modal="true" aria-label={t.nav.menu}>
    <div class="container-x flex h-[4.5rem] items-center justify-between">
      <Logo size={38} />
      <button type="button" class="inline-flex size-11 items-center justify-center rounded-full bg-[var(--color-paper)]" data-menu-close>
        <span class="sr-only">{t.nav.close}</span>
        <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18" /></svg>
      </button>
    </div>
    <nav aria-label={t.nav.primary} class="container-x overflow-y-auto pb-10" style="max-height: calc(100dvh - 4.5rem)">
      <ul class="mt-4 divide-y divide-[rgb(31_58_51/0.1)] border-y border-[rgb(31_58_51/0.1)]">
        {[...items, ...mobileExtra].map((it, i) => (
          <li>
            <a
              href={href(it.key, lang)}
              aria-current={route === it.key ? 'page' : undefined}
              class="group flex items-baseline justify-between py-3.5 font-display text-[1.75rem] leading-tight"
            >
              <span class:list={[route === it.key && 'italic-sun']}>{it.label}</span>
              <span class="text-sm font-sans font-semibold text-[var(--color-ink-soft)]" aria-hidden="true">0{i + 1}</span>
            </a>
          </li>
        ))}
      </ul>
      <a href={href('tour', lang)} class="btn btn-primary mt-8 w-full">{t.nav.tour}</a>
    </nav>
  </div>

<script>
  const openBtn = document.querySelector<HTMLButtonElement>('[data-menu-open]');
  const panel = document.querySelector<HTMLElement>('[data-menu-panel]');
  const closeBtn = document.querySelector<HTMLButtonElement>('[data-menu-close]');
  if (openBtn && panel && closeBtn) {
    const setOpen = (open: boolean) => {
      panel.classList.toggle('hidden', !open);
      openBtn.setAttribute('aria-expanded', String(open));
      document.documentElement.style.overflow = open ? 'hidden' : '';
      (open ? closeBtn : openBtn).focus();
    };
    openBtn.addEventListener('click', () => setOpen(true));
    closeBtn.addEventListener('click', () => setOpen(false));
    panel.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') setOpen(false);
      if (e.key !== 'Tab') return;
      const f = panel.querySelectorAll<HTMLElement>('a[href], button');
      const first = f[0], last = f[f.length - 1];
      if (!first || !last) return;
      if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
      else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
    });
  }
</script>
